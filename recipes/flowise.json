{
  "id": "flowise",
  "name": "Flowise",
  "icon": "Workflow",
  "tint": "#7b61ff",
  "repo": "https://github.com/FlowiseAI/Flowise",
  "install": "mkdir -p ../flowise-bin && cd ../flowise-bin && { [ -f package.json ] || npm init -y >/dev/null; } && npm install --no-audit --no-fund flowise@latest",
  "start": "./node_modules/.bin/flowise start",
  "port": 5306,
  "world": "flowise-world",
  "vendors": [
    "anthropic",
    "openai"
  ],
  "window": {
    "w": 1200,
    "h": 780
  },
  "notes": "LLM flow builder; runs SEALED in a twin world — AI vendors are twins, no real keys",
  "cwd": "programs/flowise-bin",
  "auth": {
    "login": {
      "path": "/api/v1/auth/login",
      "json": {
        "email": "${email}",
        "password": "${password}"
      }
    },
    "register": {
      "path": "/api/v1/account/register",
      "json": {
        "user": {
          "name": "Owner",
          "email": "${email}",
          "credential": "${password}"
        }
      }
    },
    "store": [
      {
        "key": "isAuthenticated",
        "value": "true"
      },
      {
        "key": "user",
        "from": "."
      },
      {
        "key": "permissions",
        "from": "permissions"
      },
      {
        "key": "features",
        "from": "features"
      }
    ]
  }
}